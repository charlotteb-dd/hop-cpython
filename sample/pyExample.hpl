  <transform>
    <type>CPythonScriptExecutor</type>
    <name>Create scatter plot, Andrew's curves, Parallel coordinates, and RadViz</name>
    <script>import matplotlib.pyplot as plt
from pandas.plotting import scatter_matrix, andrews_curves, parallel_coordinates, radviz
import numpy as np

iris = py_data  # Ensure py_data is already defined

# Summarize the input data
summary = str(iris.describe(include='all'))

# Scatter plot
scatter = scatter_matrix(iris, figsize=(12, 12), diagonal='kde')
fig = scatter[0][0].get_figure()
fig.set_dpi(100)  # Set DPI to 100

# Andrew's curves
fig2 = plt.figure(figsize=(12, 12), dpi=100)
andrews_curves(iris, 'class')

# Parallel coordinates
fig3 = plt.figure(figsize=(12, 12), dpi=100)
parallel_coordinates(iris, 'class')

# RadViz
fig4 = plt.figure(figsize=(12, 12), dpi=100)
radviz(iris, 'class')

</script>
